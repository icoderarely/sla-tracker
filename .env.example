# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-only, used by /api/cron/sla-check to bypass RLS.
# NEVER expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret the external cron caller sends as `Authorization: Bearer <value>`.
CRON_SECRET=choose-a-long-random-string

# Optional: POSTed to when a thread crosses the 2-hour SLA mark (e.g. a Slack
# incoming webhook URL, or a Zapier/Make webhook that forwards to email/SMS).
SLA_ALERT_WEBHOOK_URL=
